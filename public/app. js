const API=(window.MANA_API_BASE||"").replace(/\/$/,"");document.getElementById("year").textContent=new Date().getFullYear();document.getElementById("menu").onclick=()=>{const n=document.getElementById("nav");n.style.display=n.style.display==="flex"?"none":"flex"};
const templates={host:`<label>City / State *</label><input name="city" required maxlength="100"><label>Languages *</label><input name="language" required maxlength="100"><label>Hosting experience</label><select name="experience"><option>New</option><option>Some experience</option><option>Experienced</option></select>`,agency:`<label>Agency name *</label><input name="agencyName" required maxlength="120"><label>City / State *</label><input name="city" required maxlength="100"><label>Approximate host count</label><select name="hostCount"><option>1–10</option><option>11–25</option><option>26–50</option><option>51+</option></select>`,bd:`<label>City / State *</label><input name="city" required maxlength="100"><label>Languages / regions *</label><input name="languages" required maxlength="150"><label>BD experience</label><select name="experience"><option>New</option><option>Some experience</option><option>Experienced</option></select>`};
function setType(t){document.getElementById("type").value=t;document.getElementById("extra").innerHTML=templates[t];document.querySelectorAll(".tab").forEach(b=>b.classList.toggle("active",b.dataset.type===t));}document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>setType(b.dataset.type));setType("host");
document.getElementById("applyForm").onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,s=document.getElementById("formStatus"),b=f.querySelector("button");const d=Object.fromEntries(new FormData(f));d.consent=f.elements.consent.checked;b.disabled=true;b.textContent="Submitting…";try{if(!API)throw Error("API is not configured yet.");const r=await fetch(API+"/api/applications",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(d)});const j=await r.json();if(!r.ok)throw Error(j.error||"Submission failed");f.reset();setType("host");s.textContent="Thank you! Reference: "+j.reference;s.style.color="#9be7bd";}catch(x){s.textContent=x.message;s.style.color="#ff9db8";}finally{b.disabled=false;b.textContent="Submit application ↗";}};






